{
	"name": "ens-normalize-derive",
	"private": true,
	"description": "Derives the ENSIP-15 normalization spec (spec.json, nf.json) from Unicode data files",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adraffy/ens-normalize-derive.git"
	},
	"type": "module",
	"scripts": {
		"derive": "bun scripts/derive.ts",
		"make-tests": "bun scripts/make-tests.ts",
		"check": "bun scripts/derive.ts --check && bun scripts/make-tests.ts --check",
		"review": "bun scripts/review.ts",
		"group-stats": "bun scripts/group-stats.ts",
		"parity": "bun scripts/parity.ts",
		"registrations": "bun scripts/registrations.ts",
		"download:unicode": "bun scripts/download-unicode.ts",
		"download:cldr": "bun scripts/download-cldr.ts",
		"names": "bun scripts/names.ts",
		"diff": "bun scripts/diff.ts",
		"test": "bun test",
		"lint": "biome check . && bun scripts/lint-rules.ts",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@adraffy/ens-normalize": "1.11.1",
		"@biomejs/biome": "^2.6.9",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2",
		"viem": "^2.58.6"
	}
}
